# =============================================================================
#   MEDICAL RAG AI ASSISTANT — Environment Variables Template
# =============================================================================
#   Copy this file to '.env' and populate with your credentials.
# =============================================================================

# Cohere API Key for text embeddings (embed-english-v3.0)
# Required if you want high-quality cloud embeddings.
# If empty, the system falls back to local offline FastEmbed on CPU.
COHERE_API_KEY=your_cohere_api_key_here

# Groq API Key for primary cloud generation (llama-3.3-70b-specdec)
# If empty or quota is exhausted, the system automatically redirects
# to a local Ollama model (e.g. llama3/mistral).
GROQ_API_KEY=your_groq_api_key_here

# Qdrant Vector DB Configuration
# By default, connection is routed to Docker 'localhost:6333'.
# If docker is offline, it falls back to embedded storage under data/qdrant_db.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=who_guidelines
